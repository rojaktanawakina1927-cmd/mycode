{
  "name": "Medical 3D Short — Remotion",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096"
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y ffmpeg && cd remotion && npm install && npx remotion browser ensure",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Remotion Studio",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
