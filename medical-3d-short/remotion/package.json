{
  "name": "medical-3d-short",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "remotion studio src/index.ts",
    "start:lite": "remotion studio src/lite-entry.ts",
    "compositions": "remotion compositions src/index.ts",
    "compositions:lite": "remotion compositions src/lite-entry.ts",
    "still": "remotion still src/index.ts SeatBeltShort out/still.png --frame=900",
    "still:lite": "remotion still src/lite-entry.ts SeatBeltLite out/still-lite.png --frame=900",
    "render": "remotion render src/index.ts SeatBeltShort out/seatbelt.mp4",
    "render:lite": "remotion render src/lite-entry.ts SeatBeltLite out/seatbelt-lite.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "^8.0.0",
    "@remotion/three": "4.0.547",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.547",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.547",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.180.0",
    "typescript": "^5.6.3"
  }
}
